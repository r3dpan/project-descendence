GOOSE_DRIVER=<DB_DRIVER>
GOOSE_DBSTRING=<DB_DRIVER>://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations

DATABASE_URL=<DB_DRIVER>://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=disable

PODMAN_SOCKET=<PATH_TO_ROOTLESS_PODMAN_SOCKET, e.g. $XDG_RUNTIME_DIR/podman/podman.sock>

# OIDC (Phase 9, ARCHITECTURE.md §4.10, decision #34). Browser login is
# OIDC-only - there is no local password fallback. cmd/api discovers the
# issuer once at startup and refuses to start if discovery fails, so all
# four of these (except OIDC_CLIENT_SECRET, which may be empty for a public
# client) are effectively required for the API to serve browser traffic at
# all; cmd/seed's token path still works with the IdP down.
OIDC_ISSUER_URL=<ISSUER_URL, e.g. http://localhost:9000/application/o/descendence/>
OIDC_CLIENT_ID=<OAUTH2_CLIENT_ID>
OIDC_CLIENT_SECRET=<OAUTH2_CLIENT_SECRET>

# Must exactly match the redirect URI configured on the IdP's OAuth2
# provider/application - use 127.0.0.1, not localhost: the session cookie
# is host-scoped, and mixing the two breaks login silently. Optional;
# defaults to http://127.0.0.1:8080/api/v1/auth/callback.
#OIDC_REDIRECT_URL=<REDIRECT_URL, e.g. http://127.0.0.1:8080/api/v1/auth/callback>

# Space-separated OAuth2 scopes requested at login. Optional; defaults to
# "openid profile email" - the minimum this integration needs (sub for
# identity, preferred_username for the JIT display name and the bootstrap
# match below).
#OIDC_SCOPES=openid profile email

# A JIT-provisioned principal (first-ever login from an unknown subject)
# whose preferred_username matches this gets the admin role, in the same
# transaction as its creation - the one first-admin exception, the same
# role cmd/seed's bootstrap token plays for the CLI. Creation-time only; a
# later login never re-checks it. Optional; leave unset to disable
# bootstrap entirely (every JIT principal then starts roleless).
#OIDC_BOOTSTRAP_USERNAME=<YOUR_IDP_USERNAME>

# Where run log bodies are written (one file per run). The supervisor writes
# this directory and the api reads it, so both processes must be given the
# same path. Created on first use.
RUN_LOG_DIR=<PATH_TO_RUN_LOG_DIRECTORY, e.g. $HOME/.local/share/descendence/logs>

# Where job definitions live, as bare git repositories (one per repo record).
# The api is the sole writer - it creates repositories, commits uploaded files
# and scans them for manifests - and the supervisor only reads a script blob at
# the commit a run pinned. Like RUN_LOG_DIR, both processes must be given the
# same path, with the roles reversed. Created on first use.
GIT_REPO_DIR=<PATH_TO_GIT_REPO_DIRECTORY, e.g. $HOME/.local/share/descendence/repos>

# How long run output is kept before the supervisor's hourly sweep deletes it
# (a Go duration). Run records themselves are kept forever - only their logs
# expire. Optional; defaults to 720h (30 days).
#RUN_LOG_RETENTION=720h

# How many days a runtime image can go unreferenced by any run or live job
# before the supervisor's hourly sweep reclaims it (task 4.7; a plain integer
# day count, not a Go duration - unlike RUN_LOG_RETENTION above). The
# runtime row itself is kept forever - only the image is deleted. Optional;
# defaults to 30. A manual prune via POST /api/v1/runtimes/prune uses the
# same "unused" rule regardless of this setting.
#RUNTIME_IMAGE_RETENTION_DAYS=30

# Where the supervisor writes generated systemd (user) .timer/.service unit
# files for schedules (ARCHITECTURE.md §4.8, decision #27, task 5.3). Unlike
# RUN_LOG_DIR/GIT_REPO_DIR this is host-local systemd-unit state, not shared
# between api and supervisor - the api process never touches this directory.
# Optional; defaults to $HOME/.config/systemd/user.
#SYSTEMD_UNIT_DIR=<PATH_TO_SYSTEMD_USER_DIR, e.g. $HOME/.config/systemd/user>

# The descendence CLI binary a generated schedule's .service unit invokes
# (task 5.3's ExecStart). A systemd user service's PATH is not guaranteed to
# match an interactive shell's, so this is best set to an absolute path once
# the CLI is installed somewhere permanent. Optional; defaults to
# "descendence" (relies on PATH).
#DESCENDENCE_CLI_PATH=<PATH_TO_DESCENDENCE_BINARY, e.g. /usr/local/bin/descendence>

# EnvironmentFile a generated schedule's .service unit reads for its
# DESCENDENCE_URL/DESCENDENCE_TOKEN (the same two env vars cmd/cli already
# reads, cmd/cli/config.go) - task 5.3/5.7's scheduler principal, see
# cmd/seed's -name/-scopes flags. Not read by cmd/api or cmd/supervisor
# themselves, only referenced when rendering unit files. Optional; defaults
# to $HOME/.config/descendence/scheduler.env.
#DESCENDENCE_SCHEDULER_ENV_FILE=<PATH, e.g. $HOME/.config/descendence/scheduler.env>

# A dedicated file holding just DATABASE_URL/PODMAN_SOCKET, editable from
# the web UI's Configuration page (GET/PUT /api/v1/config, config:read/
# config:write) without touching this .env file. Loaded by both cmd/api
# and cmd/supervisor at startup: a value from this file is used only if
# the corresponding environment variable above is unset - an env var
# always wins, so ops/systemd EnvironmentFile= overrides still work
# unchanged. No hot-reload: edits here (or via the UI) take effect only
# on the next restart of both processes. Optional; defaults to
# $HOME/.config/descendence/config.env.
#DESCENDENCE_CONFIG_FILE=<PATH, e.g. $HOME/.config/descendence/config.env>
